       IDENTIFICATION DIVISION.
       PROGRAM-ID. CICSREAD.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-RESP PIC S9(8) COMP.
       01  CUST-KEY PIC X(6) VALUE 'C00001'.
       01  CUST-REC PIC X(80).
       PROCEDURE DIVISION.
       MAIN.
           EXEC CICS HANDLE CONDITION NOTFND(NOT-FOUND) END-EXEC.
           EXEC CICS READ FILE('CUSTFILE') INTO(CUST-REC)
               RIDFLD(CUST-KEY) RESP(WS-RESP)
           END-EXEC.
           EXEC CICS RETURN END-EXEC.
       NOT-FOUND.
           EXEC CICS SEND TEXT FROM(CUST-KEY) LENGTH(6) END-EXEC.
           EXEC CICS RETURN END-EXEC.
